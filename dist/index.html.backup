&lt;!doctype html&gt;
&lt;html lang="zh-CN"&gt;
  &lt;head&gt;
    &lt;meta charset="UTF-8" /&gt;
    &lt;meta name="viewport" content="width=device-width, initial-scale=1.0" /&gt;
    &lt;title&gt;宁小包&lt;/title&gt;
    &lt;link rel="preconnect" href="https://fonts.googleapis.com" /&gt;
    &lt;link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /&gt;
    &lt;link href="https://fonts.googleapis.com/css2?family=Archivo+Black&amp;family=Space+Mono:wght@400;700&amp;display=swap" rel="stylesheet" /&gt;
    &lt;script type="module" crossorigin src="./assets/index-Dg24nuQD.js"&gt;&lt;/script&gt;
    &lt;link rel="stylesheet" crossorigin href="./assets/index-DeZ8CYAY.css" /&gt;
    &lt;style&gt;
      .daily-iframe-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(4px);
        z-index: 9998;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s, visibility 0.3s;
      }
      .daily-iframe-overlay.active {
        opacity: 1;
        visibility: visible;
      }
      .daily-iframe-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.9);
        width: 90%;
        max-width: 800px;
        height: 85vh;
        background: white;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        z-index: 9999;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s, visibility 0.3s, transform 0.3s;
      }
      .daily-iframe-container.active {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, -50%) scale(1);
      }
      .daily-iframe-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        background: linear-gradient(135deg, #E8F4FD, #F0F7FF);
        border-bottom: 1px solid rgba(200, 225, 245, 0.5);
      }
      .daily-iframe-title {
        font-size: 18px;
        font-weight: 800;
        background: linear-gradient(135deg, #1E293B, #60A5FA, #F472B6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .daily-iframe-close {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        font-size: 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.2s;
      }
      .daily-iframe-close:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: scale(1.1);
      }
      .daily-iframe-body {
        width: 100%;
        height: calc(100% - 60px);
        border: none;
      }
      .debug-log {
        position: fixed;
        bottom: 10px;
        left: 10px;
        background: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 10px;
        border-radius: 8px;
        font-size: 12px;
        max-width: 400px;
        z-index: 10000;
        display: none;
      }
    &lt;/style&gt;
  &lt;/head&gt;
  &lt;body&gt;
    &lt;div id="root"&gt;&lt;/div&gt;
    &lt;div class="daily-iframe-overlay" id="dailyOverlay"&gt;&lt;/div&gt;
    &lt;div class="daily-iframe-container" id="dailyContainer"&gt;
      &lt;div class="daily-iframe-header"&gt;
        &lt;span class="daily-iframe-title"&gt;☁️ 我的日常&lt;/span&gt;
        &lt;button class="daily-iframe-close" id="dailyCloseBtn"&gt;✕&lt;/button&gt;
      &lt;/div&gt;
      &lt;iframe class="daily-iframe-body" id="dailyIframe" src="about:blank"&gt;&lt;/iframe&gt;
    &lt;/div&gt;
    &lt;div class="debug-log" id="debugLog"&gt;&lt;/div&gt;
    &lt;script&gt;
      (function() {
        var overlay = document.getElementById('dailyOverlay');
        var container = document.getElementById('dailyContainer');
        var iframe = document.getElementById('dailyIframe');
        var closeBtn = document.getElementById('dailyCloseBtn');
        var debugLog = document.getElementById('debugLog');
        var isOpen = false;
        var navInserted = false;

        function log(msg) {
          var time = new Date().toLocaleTimeString();
          debugLog.innerHTML = '&lt;div&gt;[' + time + '] ' + msg + '&lt;/div&gt;' + debugLog.innerHTML;
          console.log(msg);
        }

        function openDaily(e) {
          if (e) e.preventDefault();
          log('打开日常');
          if (!isOpen) {
            iframe.src = './daily.html';
            overlay.classList.add('active');
            container.classList.add('active');
            isOpen = true;
          }
        }

        function closeDaily() {
          log('关闭日常');
          if (isOpen) {
            overlay.classList.remove('active');
            container.classList.remove('active');
            setTimeout(function() {
              iframe.src = 'about:blank';
            }, 300);
            isOpen = false;
          }
        }

        overlay.addEventListener('click', closeDaily);
        closeBtn.addEventListener('click', closeDaily);

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' &amp;&amp; isOpen) {
            closeDaily();
          }
        });

        function insertDailyNav() {
          if (navInserted) return true;
          
          log('寻找导航链接...');
          var navLinks = document.querySelectorAll('a, [role="link"]');
          var contactLink = null;
          var portfolioLink = null;
          
          navLinks.forEach(function(link) {
            var text = (link.textContent || link.innerText || '').toLowerCase().trim();
            var href = link.getAttribute('href') || '';
            
            log('找到链接: "' + text + '" href: ' + href);
            
            if (text.indexOf('联系') !== -1 || text.indexOf('contact') !== -1 || href.indexOf('contact') !== -1) {
              contactLink = link;
              log('→ 这是联系链接!');
            }
            if (text.indexOf('作品') !== -1 || text.indexOf('portfolio') !== -1 || text.indexOf('work') !== -1 || href.indexOf('portfolio') !== -1) {
              portfolioLink = link;
              log('→ 这是作品链接!');
            }
          });

          var insertAfter = contactLink;
          var insertBefore = portfolioLink;
          
          if (insertAfter || insertBefore) {
            log('准备插入日常链接');
            var dailyLink = document.createElement('a');
            dailyLink.href = '#daily';
            dailyLink.textContent = '日常';
            dailyLink.style.cursor = 'pointer';
            dailyLink.addEventListener('click', openDaily);

            if (insertAfter &amp;&amp; insertAfter.parentNode) {
              if (insertAfter.nextSibling) {
                insertAfter.parentNode.insertBefore(dailyLink, insertAfter.nextSibling);
              } else {
                insertAfter.parentNode.appendChild(dailyLink);
              }
              log('✓ 已插入到联系链接后面');
            } else if (insertBefore &amp;&amp; insertBefore.parentNode) {
              insertBefore.parentNode.insertBefore(dailyLink, insertBefore);
              log('✓ 已插入到作品链接前面');
            }
            navInserted = true;
            return true;
          }
          log('✗ 没有找到合适的位置插入');
          return false;
        }

        function removeGradientCircle() {
          var elements = document.querySelectorAll('div');
          for (var i = 0; i &lt; elements.length; i++) {
            var el = elements[i];
            var bg = el.style.background || '';
            var classes = el.className || '';
            if (bg.indexOf('conic-gradient') !== -1 &amp;&amp; bg.indexOf('210deg') !== -1 || 
                classes.indexOf('absolute') !== -1 &amp;&amp; classes.indexOf('rounded-[999px]') !== -1) {
              el.style.display = 'none';
            }
          }
        }

        function tryInsertNav() {
          if (!navInserted) {
            var success = insertDailyNav();
            if (!success) {
              requestAnimationFrame(tryInsertNav);
            }
          }
          removeGradientCircle();
        }

        log('脚本已加载，等待页面...');
        
        if (document.readyState === 'complete') {
          tryInsertNav();
        } else {
          window.addEventListener('load', tryInsertNav);
        }

        setTimeout(tryInsertNav, 100);
        setTimeout(tryInsertNav, 500);
        setTimeout(tryInsertNav, 1000);
        setTimeout(tryInsertNav, 2000);
        setTimeout(removeGradientCircle, 200);
        setInterval(removeGradientCircle, 1000);
        
        log('完成初始化');
      })();
    &lt;/script&gt;
  &lt;/body&gt;
&lt;/html&gt;
